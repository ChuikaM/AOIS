{
  "version": 6,
  "include": ["./Lab1Presets.json"],
  "configurePresets": [
    {
      "name": "debug-lab1",
      "displayName": "Debug config (Lab1)",
      "description": "Debug config with tests (Lab1 dependencies used)",
      "inherits": "lab1-debug",
      "installDir": "${sourceDir}/build/Debug/install",
      "generator": "Ninja"
    },
    {
      "name": "release-lab1",
      "displayName": "Release config (Lab1)",
      "description": "Release config (Lab1 dependencies used)",
      "installDir": "${sourceDir}/build/Release/install",
      "inherits": "lab1-release",
      "generator": "Ninja"
    },
    {
      "name": "release-with-tests-lab1",
      "displayName": "Release config with tests (Lab1)",
      "description": "Release config with tests (Lab1 dependencies used)",
      "inherits": "release-lab1",
      "cacheVariables": {
        "LAB1_BUILD_TESTS": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug-lab1"
    },
    {
      "name": "release",
      "configurePreset": "release-lab1"
    }
  ]
}